# Credenciais administrativas do Firebase (conta de serviço).
# Valores reais ficam SOMENTE nas variáveis secretas da hospedagem; nunca no repositório.
FIREBASE_PROJECT_ID=seu-project-id
FIREBASE_CLIENT_EMAIL=email-da-conta-de-servico
FIREBASE_PRIVATE_KEY=CONFIGURAR_APENAS_NA_HOSPEDAGEM

# URL do Realtime Database (não é segredo).
FIREBASE_DATABASE_URL=https://seu-project-id-default-rtdb.firebaseio.com

# Porta HTTP (a hospedagem costuma definir sozinha).
PORT=3000
