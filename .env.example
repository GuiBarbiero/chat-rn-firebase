# Variáveis do aplicativo (todas públicas e opcionais: os valores padrão ficam em src/config.ts).
# Para sobrescrever, copie este arquivo para ".env" e ajuste. Nenhum segredo deve ser colocado aqui.

# URL pública da API de grupos e notificações
EXPO_PUBLIC_API_URL=https://sua-api.onrender.com

# Cloudinary (armazenamento das fotos de perfil e de grupo)
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=seu-cloud-name
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=chat_unsigned

# Somente desenvolvimento: host dos emuladores do Firebase (ex.: localhost). Vazio = Firebase real.
EXPO_PUBLIC_EMULATOR_HOST=
